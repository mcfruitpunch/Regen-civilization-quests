{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/regen/quest.schema.json",
  "title": "REGEN illustrative quest (v0.1)",
  "description": "A content contract, not approval to deploy a quest in the real world.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "version",
    "title",
    "summary",
    "stage",
    "domain",
    "kind",
    "estimated_minutes",
    "setting",
    "skills",
    "objective",
    "steps",
    "reflection_prompt",
    "accessibility_alternative",
    "consent_requirement",
    "safety_notes",
    "evidence_level",
    "next_quest_id",
    "atlas_refs",
    "publication_status"
  ],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
    },
    "version": {
      "type": "string",
      "pattern": "^\\d+\\.\\d+\\.\\d+$"
    },
    "title": {
      "type": "string",
      "minLength": 6,
      "maxLength": 100
    },
    "summary": {
      "type": "string",
      "minLength": 12,
      "maxLength": 200
    },
    "stage": {
      "type": "integer",
      "minimum": 1,
      "maximum": 7
    },
    "domain": {
      "enum": [
        "Community",
        "Learning",
        "Repair",
        "Food",
        "Civic",
        "Systems"
      ]
    },
    "kind": {
      "enum": [
        "learn",
        "observe",
        "act",
        "collaborate",
        "transform"
      ]
    },
    "estimated_minutes": {
      "type": "integer",
      "minimum": 1,
      "maximum": 10080
    },
    "setting": {
      "enum": [
        "remote",
        "home",
        "community",
        "flexible"
      ]
    },
    "skills": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 3
      }
    },
    "objective": {
      "type": "string",
      "minLength": 10
    },
    "steps": {
      "type": "array",
      "minItems": 2,
      "maxItems": 8,
      "items": {
        "type": "string",
        "minLength": 10
      }
    },
    "reflection_prompt": {
      "type": "string",
      "minLength": 10
    },
    "accessibility_alternative": {
      "type": "string",
      "minLength": 10
    },
    "consent_requirement": {
      "type": "string",
      "minLength": 10
    },
    "safety_notes": {
      "type": "string",
      "minLength": 10
    },
    "evidence_level": {
      "enum": [
        "self_report",
        "participant_reflection",
        "reviewed",
        "independent"
      ]
    },
    "next_quest_id": {
      "type": [
        "string",
        "null"
      ]
    },
    "atlas_refs": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string"
      }
    },
    "publication_status": {
      "enum": [
        "illustrative_only",
        "draft",
        "under_review",
        "approved",
        "retired"
      ]
    }
  }
}
